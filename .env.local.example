NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend — used as Supabase Auth SMTP for the 6-digit OTP sign-in email (from hello@assignreps.com).
# Configured in the Supabase dashboard (Auth → SMTP), NOT read by app code.
# Stored here only for reference/documentation of the auth email provider.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe — $10/mo subscription. Free tier is 3 students, paywall at the 4th.
# Test and live mode are entirely separate: keys, products, prices and coupons
# created in one are meaningless in the other, so every value here changes when
# you switch. sk_test_/sk_live_ is the giveaway for which mode you are in.
#
# STRIPE_PRICE_ID is not a secret — it reaches the browser in the Checkout
# redirect. It lives here rather than in source so switching test -> live is a
# config change, not a code change.
#
# STRIPE_WEBHOOK_SECRET does not exist until an endpoint does. For local work it
# comes from `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# which issues its own whsec_ distinct from any dashboard endpoint's.
#
# ⚠️ Placeholders use <angle-brackets>, not runs of x. `sk_test_` followed by 24
# alphanumerics matches GitHub's Stripe secret pattern exactly, so an obviously
# fake xxxx placeholder still trips push protection and blocks the push. The
# scanner cannot tell a fake key from a real one — only the shape.
STRIPE_SECRET_KEY=sk_test_<your-test-secret-key>
STRIPE_PRICE_ID=price_<your-price-id>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>
